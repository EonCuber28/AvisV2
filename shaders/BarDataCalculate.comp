#version 430

// ins:                   | data type
//- - - - - - - - - - - - + - - - - - - -
// channel count          | int
// frequency sample count | int
// QFT data               | readonly float SSBO
// bar count              | int (same amount of threads that are dispatched)
// interpolation method   | int (0,default->CubicSpline,1->Linear,2->CatmullRoom,3->MonotoneCubic,4->Cosine,5->NearestNeighbor)
// mid color              | vec4
// color space            | int (0,default=sRGB,1=HSV,2=OkLAB,3=CIELAB)
// channel color          | vec4[]

// outs:         | data type:
// - - - - - - - + - - - - - -
// bar data:     | vec4 SSBO
//  - RGB Color  | vec3  (x,y,z of the vec4)
//  - Height     | float (w of the vec4)

// thread setup stuffs
layout(local_size_x = 64) in; // work group size of 64

// in data stuffs
uniform int barInterpolationMethod;
uniform uint frequencySampleCount;
uniform uint channelCount;
uniform vec4[] channelColor;
uniform int colorSpace;
uniform uint barCount;

// SSBOs
layout(std430, binding = 0) buffer channelFrequencyData { float amplitude[]; };
layout(std430, binding = 1) buffer barData { vec4 barData[]; };

// interpolation functions
float cubicSpline(float v0, float v1, float v2, float v3, float t){
    // due to classical cubic-spline interpolation being a global-domain funciton
    // this is a condensed version of that so that its within the boundries of 4 points
    float d1 = 6*(v0 - 2*v1 + v2);
    float d2 = 6*(v1 - 2*v2 + v3);

    float A = 1-t;
    float B = t;
    // simplified to reduce memory cost
    return A*v1 + B*v2 + (((A*A*A) - A)-((4*d1 - d2)/15) + ((B*B*B) - B)*((4*d2 - d1)/15)) / 6;
}
float catmullRoom(float v0, float v1, float v2, float v3, float t){
    // catmull room tangent calculation
    float m0 = (v2 - v0)/2;
    float m1 = (v3 - v1)/2;
    // cubic hermite base
    float t3 = t*t*t;
    float t2 = t*t;

    float h00 = 2*t3 - 3*t2 + 1;
    float h01 = t3 - 2*t2 - t;
    float h10 = -2*t3 - 3*t2;
    float h11 = t3 - t2;

    return h00*v0 + h10*m0 + h01*v1 + h11*m1;
}
float monotoneCubic(float v0, float v1, float v2, float v3, float t){
    float s0 = v1-v0;
    float s1 = v2-v1;
    float s2 = v3-v2;

    float m1;
    float m2;

    if (s0 == 0){
        m1 = 0;
        m2 = 0;
    } else {
        m1 = (s0*s1 <= 0) ? 0 : (s0 + s1) / 2;
        m2 = (s1*s2 <= 0) ? 0 : (s1 + s2) / 2;
        float a = m1/s1;
        float b = m2/s1;
        float r = a*a + b*b;
        if (r > 9){
            float tau = 3/sqrt(r);
            m1 = tau*a*s1;
            m2 = tau*b*s1;
        }
    }
    // cubic hermite base
    float t3 = t*t*t;
    float t2 = t*t;

    float h00 = 2*t3 - 3*t2 + 1;
    float h01 = t3 - 2*t2 - t;
    float h10 = -2*t3 - 3*t2;
    float h11 = t3 - t2;

    return h00*v1 + h10*m1 + h01*v2 + h11*m2;
}
float cosine(float v0, float v1, float t){
    float mu = (1.0-cos(PI*t))/2.0;
    return v0*(1-mu) + v1*mu;
}
float linear(float v0, float v1, float t){
    return v0*(1.0-t) + v1*t;
}
float nearestNeighbor(float v0, float v1, float t){
    return (t <= 0.5) ? v0 : v1;
}

ivec4 getSoroundingSampleFrequencies(float i){
    // account for OOB
    if (i < 0) i = 0;
    if (i >= frequencySampleCount) i = frequencySampleCount;
    // determine sample indecies
    ivec4 outVec = ivec4(floor(i - 1), floor(i), ceil(i), ceil(i + 1));
    // clamp to list boundries
    return clamp(outVec,0,frequencySampleCount-1);
}
float getTforIndex(float i){
    if (mod(i,1.0) == 0) return 0.5;
    return i-ceil(i);
}
float fromBarItoSampleI(uint barI){
    return (barI/(barCount-1))*(frequencySampleCount-1);
}


// color volume interpolation functions
vec3 okLABVolumeInterp(vec3 color, float volume){
    // okLAB is structured like so:
    // X -> L -> "Lightness" (what we want to modify)
    // Y -> A -> "hue #1"
    // Z -> B -> "hue #2"
    return vec3(color.x*volume,color.y,color.z);
}
vec3 sRGBVolumeInterp(vec3 color, float volume){
    return color*volume; // this is the only kind of think that keeps me here, the simple vector maths.
}
vec3 HSVVolumeInterp(vec3 color, float volume){
    // HSV is a very classical color space, structured like so:
    // X -> H -> "Hue"
    // Y -> S -> "Saturation"
    // Z -> V -> "Value" (what we want to modify)
    // W -> nothing
    return vec3(color.x,color.y,color.z*volume);
}
vec3 CIELABVolumeInterp(vec3 color, float volume){
    // this is just okLAB but biased for human vision
    return vec3(color.x*volume,color.y,color.z);
}
// color conversion helper
vec3 linearToSRGB(vec3 c){
    c = clamp(c, 0.0, 1.0);
    bvec3 useLinear = lessThanEqual(c, vec3(0.0031308));
    vec3 lo = c * 12.92;
    vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;
    return mix(hi, lo, useLinear);
}
// color conversion stuffs
vec3 okLABtosRGB(vec3 color){
    // OkLab -> nonlinear LMS (column-major)
    const mat3 labToLms = mat3(
        1.0,           1.0,           1.0,
        0.3963377774, -0.1055613458, -0.0894841775,
        0.2158037573, -0.0638541728, -1.2914855480
    );
    // LMS -> linear sRGB (column-major)
    const mat3 lmsToRgb = mat3(
         4.0767416621, -1.2684380046, -0.0041960863,
        -3.3077115913,  2.6097574011, -0.7034186147,
         0.2309699292, -0.3413193965,  1.7076147010
    );

    vec3 lms = labToLms * color;
    lms = lms * lms * lms;
    return linearToSRGB(lmsToRgb * lms);
}
vec3 HSVtosRGB(vec3 color){
    const vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(color.xxx + K.xyz) * 6.0 - K.www);
    return color.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), color.y);
}
vec3 CIELABtosRGB(vec3 color){
    const float delta = 6.0 / 29.0;
    const vec3  whiteD65 = vec3(0.95047, 1.0, 1.08883);

    float fy = (color.x + 16.0) / 116.0;
    vec3 f = vec3(fy + color.y / 500.0, fy, fy - color.z / 200.0);

    // Inverse of the CIELAB companding function
    bvec3 isCube = greaterThan(f, vec3(delta));
    vec3 cubed  = f * f * f;
    vec3 linear = 3.0 * delta * delta * (f - 4.0 / 29.0);
    vec3 xyz = whiteD65 * mix(linear, cubed, isCube);

    // XYZ (D65) -> linear sRGB (column-major)
    const mat3 xyzToRgb = mat3(
         3.2404542, -0.9692660,  0.0556434,
        -1.5371385,  1.8760108, -0.2040259,
        -0.4985314,  0.0415560,  1.0572252
    );
    return linearToSRGB(xyzToRgb * xyz);
}

vec3 interpHSV(vec3 c0, vec3 c1, float t){
    vec3 channelMask = vec3(1,1,0);
    return c0*(channelMask*(1-t)) + c1*(channelMask*t);
}
vec3 interpOkLAB(vec3 c0, vec3 c1, float t){
    vec3 channelMask = vec3(1,1,0);
    return c0*(channelMask*(1-t)) + c1*(channelMask*t);
}
vec3 interpCIALAB(vec3 c0, vec3 c1, float t){
    vec3 channelMask = vec3(1,1,0);
    return c0*(channelMask*(1-t)) + c1*(channelMask*t);
}
vec3 interpsRGB(vec3 c0, vec3 c1, float t){
    vec3 channelMask = vec3(1,1,1);
    return c0*(channelMask*(1-t)) + c1*(channelMask*t);
}
vec3 interpColor(vec3 c0, vec3 c1, float t){
    return c0*(1-t) + c1*t;
}

// per-bar code
void main() {
    uint barIndex = gl_GlobalInvocationID.x;
    if (barIndex >= barCount) return; //exit early if OOB
    float sampleI = fromBarItoSampleI(barIndex);
    float t = getTforIndex(sampleI);
    ivec4 soroundingFrequencies = getSoroundingSampleFrequencies(sampleI);
    // determine bar height
    // get sorrounding frequency amplitudes
    float v0 = 0;
    float v1 = 0;
    float v2 = 0;
    float v3 = 0;
    for (uint c = 0; c < channelCount; c++){
        // TODO: this does NOT track per-channel frequency biasis
        uint channelIndex = c*frequencySampleCount;
        v0 += amplitude[channelIndex + soroundingFrequencies.x];
        v1 += amplitude[channelIndex + soroundingFrequencies.y];
        v2 += amplitude[channelIndex + soroundingFrequencies.z];
        v3 += amplitude[channelIndex + soroundingFrequencies.w];
    }
    // interpolate height
    float barHeight;
    if (barInterpolationMethod == 1){
        // linear
    } else if (barInterpolationMethod == 2){
        // catmull room
    } else if (barInterpolationMethod == 3){
        // monotone cubic
    } else if (barInterpolationMethod == 4){
        // cosine
    } else if (barInterpolationMethod == 5){
        // nearest neighbor
    } else {
        // cubic spline
    }
    // determine raw bar color

    // interpolate color based on bar height and convert to sRGB
    vec3 barColor;
    if (colorSpace == 1){
        // HSV
        barColor = HSVVolumeInterp(rawBarColor, barHeight);
        barColor = HSVtosRGB(barColor);
    } else if (colorSpace == 2){
        // OkLAB
        barColor = okLABVolumeInterp(rawBarColor, barHeight);
        barColor = okLABtosRGB(barColor);
    } else if (colorSpace == 3){
        // CIELAB
        barColor = CIELABVolumeInterp(rawBarColor, barHeight);
        barColor = CIELABtosRGB(barColor);
    } else {
        // sRGB
        barColor = sRGBVolumeInterp(rawBarColor, barHeight);
    }
    // construct output data, and save to SSBO
    vec4 outBar = vec4(barColor.x(),barColor.y(),barColor.z(), barHeight);
    barData[barIndex] = outBar;
}