#version 430

// ins:                   | data type
//- - - - - - - - - - - - + - - - - - - -
// channel count          | int
// frequency sample count | int
// QFT data               | readonly float SSBO
// bar count              | int
// interpolation method   | int (0,default->CubicSpline,1->Linear,2->CatmullRoom,3->MonotoneCubic,4->Cosine,5->NearestNeighbor)
// mid color              | vec4
// color space            | int (0,default=sRGB,1=HSV,2=OkLAB,3=CIELAB)
// channel color          | vec4[]

// outs:          | data type:
//- - - - - - - - + - - - - - -
// bar heights    | float SSBO
//  - per channel |
//  - per bar     |

// thread setup stuffs
layout(local_size_x = 64) in; // work group size of 64

// in data stuffs
uniform int barInterpolationMethod;
uniform uint frequencySampleCount;
uniform uint channelCount;
uniform uint barCount;

// SSBOs
layout(std430, binding = 0) readonly buffer channelFrequencyData { float amplitude[]; };
layout(std430, binding = 1) buffer outBars { float barData[]; };

// constants
const float PI  = 3.14159265358979;
const float TAU = 6.28318530717959; // 2π

// interpolation functions
float cubicSpline(float v0, float v1, float v2, float v3, float t){
    // due to classical cubic-spline interpolation being a global-domain funciton
    // this is a condensed version of that so that its within the boundries of 4 points
    float d1 = 6*(v0 - 2*v1 + v2);
    float d2 = 6*(v1 - 2*v2 + v3);

    float A = 1-t;
    float B = t;
    // simplified to reduce memory cost
    return A*v1 + B*v2 + (((A*A*A) - A)-((4*d1 - d2)/15) + ((B*B*B) - B)*((4*d2 - d1)/15)) / 6;
}
float catmullRoom(float v0, float v1, float v2, float v3, float t){
    // catmull room tangent calculation
    float m0 = (v2 - v0)/2;
    float m1 = (v3 - v1)/2;
    // cubic hermite base
    float t3 = t*t*t;
    float t2 = t*t;

    float h00 = 2*t3 - 3*t2 + 1;
    float h01 = t3 - 2*t2 - t;
    float h10 = -2*t3 - 3*t2;
    float h11 = t3 - t2;

    return h00*v0 + h10*m0 + h01*v1 + h11*m1;
}
float monotoneCubic(float v0, float v1, float v2, float v3, float t){
    float s0 = v1-v0;
    float s1 = v2-v1;
    float s2 = v3-v2;

    float m1;
    float m2;

    if (s0 == 0){
        m1 = 0;
        m2 = 0;
    } else {
        m1 = (s0*s1 <= 0) ? 0 : (s0 + s1) / 2;
        m2 = (s1*s2 <= 0) ? 0 : (s1 + s2) / 2;
        float a = m1/s1;
        float b = m2/s1;
        float r = a*a + b*b;
        if (r > 9){
            float tau = 3/sqrt(r);
            m1 = tau*a*s1;
            m2 = tau*b*s1;
        }
    }
    // cubic hermite base
    float t3 = t*t*t;
    float t2 = t*t;

    float h00 = 2*t3 - 3*t2 + 1;
    float h01 = t3 - 2*t2 - t;
    float h10 = -2*t3 - 3*t2;
    float h11 = t3 - t2;

    return h00*v1 + h10*m1 + h01*v2 + h11*m2;
}
float cosine(float v0, float v1, float t){
    float mu = (1.0-cos(PI*t))/2.0;
    return v0*(1-mu) + v1*mu;
}
float linear(float v0, float v1, float t){
    return v0*(1.0-t) + v1*t;
}
float nearestNeighbor(float v0, float v1, float t){
    return (t <= 0.5) ? v0 : v1;
}

ivec4 getSoroundingSampleFrequencies(float i){
    // account for OOB
    if (i < 0) i = 0;
    if (i >= frequencySampleCount) i = frequencySampleCount;
    // determine sample indecies
    ivec4 outVec = ivec4(floor(i - 1), floor(i), ceil(i), ceil(i + 1));
    // clamp to list boundries
    return ivec4(clamp(outVec,0,frequencySampleCount-1));
}
float getTforIndex(float i){
    if (mod(i,1.0) == 0) return 0.5;
    return i-ceil(i);
}
float fromBarItoSampleI(uint barI){
    return (barI/(barCount-1))*(frequencySampleCount-1);
}

// per-bar code (1 thread per bar per channel)
void main() {
    uint barIndex = gl_GlobalInvocationID.x;
    uint channelIndex = gl_GlobalInvocationID.y;
    if (barIndex >= barCount || channelIndex >= channelCount) return; //exit early if OOB
    float sampleI = fromBarItoSampleI(barIndex);
    float t = getTforIndex(sampleI);
    ivec4 soroundingFrequencies = getSoroundingSampleFrequencies(sampleI);
    // calculate data
    // for this channel, get its interpolated frequency amplitude
    float interpolatedChannelFrequency;
    if (barInterpolationMethod == 1){
        // linear
        interpolatedChannelFrequency = linear(
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z], t);
    }
    else if (barInterpolationMethod == 2){
        // catmull room
        interpolatedChannelFrequency = catmullRoom(
                amplitude[soroundingFrequencies.x],
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z],
                amplitude[soroundingFrequencies.w], t);
    }
    else if (barInterpolationMethod == 3){
        // monotone cubic
        interpolatedChannelFrequency = monotoneCubic(
                amplitude[soroundingFrequencies.x],
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z],
                amplitude[soroundingFrequencies.w], t);
    }
    else if (barInterpolationMethod == 4){
        // cosine
        interpolatedChannelFrequency = cosine(
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z], t);
    }
    else if (barInterpolationMethod == 5){
        // nearest neighbor
        interpolatedChannelFrequency = nearestNeighbor(
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z], t);
    }
    else {
        // cubic spline
        interpolatedChannelFrequency = cubicSpline(
                amplitude[soroundingFrequencies.x],
                amplitude[soroundingFrequencies.y],
                amplitude[soroundingFrequencies.z],
                amplitude[soroundingFrequencies.w], t);
    }
    // save data
    barData[(channelIndex*barCount)+barIndex] = interpolatedChannelFrequency;
}