# version 430

// ins
layout(push_constant) uniform Params{
    uint channelCount;
    uint maxFreqIndex;
    float maxDiffThresh;
} params;

layout(std430, set = 0, binding = 0) readonly buffer targetFrequencies { float signal[]; }; // input from program (along with all the other args)
layout(std430, set = 0, binding = 1) readonly buffer channelFrequencyData { float amplitude[]; };
layout(std430, set = 0, binding = 2) writeonly buffer channelMaxFrequency { float bestChannelFrequency; };

float getSample(uint channel, uint sampleI){
    return amplitude[(channel*params.channelCount)+sampleI];
}

// this will just be 1 thread per channel, for 2 reasons:
// 1) This pipelines target runtime is the entire 6.95ms
// 2) This is the only way I see this working out
void main(){
    uint c = gl_GlobalInvocationID.x;
    if (c >= params.channelCount) return;
    // go through all frequencies in the given range
    // and track 1st and 2nd highest frequency indecies
    uint first = 0;
    float firstAmp = 0;
    uint second = 0;
    float secondAmp = 0;
    for (uint I = 0; I < params.maxFreqIndex; I++){
        float thisSample = getSample(c,I);
        if (thisSample > first){
            second = first;
            first = I;

            secondAmp = firstAmp;
            firstAmp = thisSample;
        }
    }
    // if their amplitude difference is past the threashhold...
    // update the frequency offset value
    if (abs(firstAmp-secondAmp) >= params.maxDiffThresh){
        bestChannelFrequency = signal[first];
    }
}