#version 430

// ins
layout(push_constant) uniform Params{
    uint audioSampleRate;
    uint channelCount;
} params;

// in SSBOs
layout(std430, set = 0, binding = 2) readonly buffer channelMaxFrequency { float bestChannelFrequency[]; };
layout(std430, set = 0, binding = 4) writeonly buffer SampleShiftAmount { float sampleShift; };

void main(){
    // average the shift frequency
    float targetFrequency = 0;
    for (int i = 0; i <= params.channelCount; i++){
        targetFrequency+=bestChannelFrequency[i];
    }
    targetFrequency/=params.channelCount;
    // calculate shift as P = f_s/f
    sampleShift = float(params.audioSampleRate)/targetFrequency;
}