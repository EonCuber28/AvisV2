#version 430

// thread allocatio stuffs
layout(local_size_x = 16, local_size_y = 16) in;

// in
layout(push_constant) uniform Params{
    vec3 BGcolor;
    vec2 smearVect; // calculated on the fly by the CPU dependant on the time delta in t
    float decayFactor; // the funny e^(-lambda*delta_t) number
} params;

layout(set = 0, binding = 7) uniform sampler2D barRender;
layout(set = 0, binding = 9) uniform sampler2D lastFrame;

layout(rgba32f, binding = 8) uniform writeonly image2D outRender;

// getters
vec4 getBarDrawColor(vec2 uv){
    return textureLod(barRender, uv, 0.0);
}
vec4 getlastFrameColor(vec2 uv){
    return textureLod(lastFrame, uv, 0.0);
}

// main code (ran once per output pixel)
void main(){
    vec2 pixel = vec2(gl_GlobalInvocationID.xy); // x, y
    ivec2 size = ivec2(imageSize(outRender));    // W, H
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    // sample pixels
    vec4 drawnBarColor = getBarDrawColor((pixel+0.5)/size); // xyz:I_t, w:M_t
    // calculate new pixel color
    vec3 newColor;
    if (drawnBarColor.w == 1){
        newColor = drawnBarColor.xyz;
    } else {
        // get shifted pixel position
        vec2 smearedPixSamplePos = pixel+params.smearVect;
        vec3 smearedPixColor;
        if (smearedPixSamplePos.x >= size.x || smearedPixSamplePos.y >= size.y
            || smearedPixSamplePos.x < 0 || smearedPixSamplePos.y < 0){
            smearedPixColor = params.BGcolor;
        } else {
            smearedPixColor = getlastFrameColor((smearedPixSamplePos+0.5)/size).xyz;
        }
        // calculate the new color
        newColor = params.BGcolor + vec3(params.decayFactor)*(smearedPixColor - params.BGcolor);
    }
    imageStore(outRender, ivec2(pixel.x,pixel.y), vec4(newColor.x,newColor.y,newColor.z,1.0));
}