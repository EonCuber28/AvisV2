#version 430

// ins:                   | data type
//- - - - - - - - - - - - + - - - - - - -
// render X               | int
// redner y               | int
// BG color               | vec3
// gay mode               | bool

// primary intermidiates: | data type:
//- - - - - - - - - - - - + - - - - - - - - -
// Ping buffer            | RGB SSBO uffer
// Pong buffer            | RGB SSBO buffer
// Bar mask               | boolean SSBO buffer
// Alpha decay            |
//   precistance texture  | float SSBO buffer

// outs:           | data type:
// - - - - - - - - + - - - - - -
// rendered output | image2D

// thread dispatch stuffs
layout(local_size_x = 16, local_size_y = 16) in;

// in
uniform int barCount;
uniform vec3 BGcolor;

// Texture setups
layout(rgba32f, binding = 1) writeonly uniform image2D renderOut;

// SSBOs
layout(std430, binding = 3) buffer inBars { vec4 barData[]; };

void drawPixel(ivec2 pixel, vec3 color){
    imageStore(renderOut, pixel, vec4(color.x,color.y,color.z,0));
}

// main code
void main(){
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(renderOut);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    // determine what bar this pixel corresponds to
    int barIdx = int(round((pixel.x/size.x)*barCount));
    vec4 thisBar = barData[barIdx];
    // determine if this pixel is within that bars bounds
    if (pixel.y <= thisBar.w*size.y){
        // draw pixel with bar color if so
        drawPixel(pixel, vec3(thisBar.xyz));
    }
    else {
        // draw BG color otherwise
        drawPixel(pixel, BGcolor);
    }
}